void printStack(char stack[], int top) 
{ 
    int i; 
 
    for(i = 0; i < top; i++) 
        printf("%c", stack[i]); 
} 
int parseG1(char input[]) 
{ 
    char stack[MAX]; 
 
    int top = 0; 
    int ip = 0; 
 
    stack[top++] = '$'; 
    stack[top++] = 'E'; 
 
    printf("\n========================================\n"); 
    printf("          PARSING GRAMMAR 1\n"); 
    printf("========================================\n\n"); 
 
    printf("%-20s %-20s %-25s\n", 
           "STACK", 
           "INPUT", 
           "ACTION"); 
 
    printf("-----------------------------------------------------------------\n"); 
 
    while(top > 0) 
    { 
        char X = stack[top - 1]; 
        char a = input[ip]; 
 
        /* Accept */ 
        if(X == '$' && a == '$') 
        { 
            printf("%-20s %-20s %-25s\n", 
                   "$", 
                   "$", 
                   "ACCEPT"); 
 
            return 1; 
        } 
        if(getColumn(X, G1_T, 6) != -1) 
        { 
            if(X == a) 
            { 
                top--; 
                ip++; 
 
                printf("%-20s %-20s %-25s\n", 
                       stack, 
                       input + ip, 
                       "Match"); 
            } 
            else 
            { 
                printf("\nERROR: Expected '%c' but found '%c'\n", 
                       X, a); 
 
                return 0; 
            } 
        } 
        else 
        { 
            int row = getRow(X, G1_NT, 5); 
            int col = getColumn(a, G1_T, 6); 
 
            if(row == -1 || col == -1) 
            { 
                printf("\nERROR: Invalid symbol '%c'\n", a); 
                return 0; 
            } 
 
            if(strlen(G1_TABLE[row][col]) == 0) 
            { 
                printf("\nERROR: No production for (%c, %c)\n", 
                       X, a); 
 
                return 0; 
            } 
 
            char production[20]; 
 
            strcpy(production, G1_TABLE[row][col]); 
 
            top--; 
 
            /* Epsilon production */ 
            if(production[0] == '#') 
            { 
                printf("%-20s %-20s %-25s\n", 
                       stack, 
                       input + ip, 
                       "Apply epsilon"); 
            } 
            else 
            { 
                int len = strlen(production); 
                int i; 
 
                for(i = len - 1; i >= 0; i--) 
                    stack[top++] = production[i]; 
 
                printf("%-20s %-20s %c -> %-20s\n", 
                       stack, 
                       input + ip, 
                       X, 
                       production); 
            } 
        } 
    } 
 
    return 0; 
} 
