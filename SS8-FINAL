void convertG1(char input[], char output[]) 
{ 
    int i = 0; 
    int j = 0; 
 
    while(input[i] != '\0') 
    { 
        if(input[i] == 'i' && 
           input[i + 1] == 'd') 
        { 
            output[j++] = 'i'; 
            i += 2; 
        } 
        else 
        { 
            output[j++] = input[i++]; 
        } 
    } 
 
    output[j++] = '$'; 
    output[j] = '\0'; 
} 
int main() 
{ 
    int choice; 
 
    char input[MAX]; 
    char converted[MAX]; 
 
