#include <stdio.h> 
#include <stdlib.h> 
#include <string.h> 
 
#define MAX 100 
char G1_NT[] = {'E','X','T','Y','F'}; 
char G1_T[]  = {'(',')','+','*','i','$'}; 
 
char G1_TABLE[5][6][20] = 
{ 
    /*        (       )       +       *       i       $    */ 
    /* E */ {"TX",   "",      "",     "",     "TX",   ""}, 
    /* X */ {"",     "#",     "+TX",  "",     "",     "#"}, 
    /* T */ {"FY",   "",      "",     "",     "FY",   ""}, 
    /* Y */ {"",     "#",     "#",    "*FY",  "",     "#"}, 
    /* F */ {"(E)",  "",      "",     "",     "i",    ""} 
}; 
 
 
char G2_NT[] = {'S','A','X','B','C'}; 
char G2_T[]  = {'a','d','b','f','g','$'}; 
 
char G2_TABLE[5][6][20] = 
{ 
    /*        a       d       b       f       g       $    */ 
    /* S */ {"A",    "",      "",     "",     "",     ""}, 
    /* A */ {"aBX",  "",      "",     "",     "",     ""}, 
    /* X */ {"",     "dX",    "",     "",     "",     "#"}, 
    /* B */ {"",     "",      "BC",   "f",    "",     ""}, 
    /* C */ {"",     "",      "",     "",     "g",    ""} 
}; 
int getColumn(char c, char terminals[], int count) 
{ 
    int i; 
 
    for(i = 0; i < count; i++) 
    { 
        if(terminals[i] == c) 
            return i; 
    } 
 
    return -1; 
} 
 
 
int getRow(char c, char nonterminals[], int count) 
{ 
    int i; 
 
    for(i = 0; i < count; i++) 
    { 
        if(nonterminals[i] == c) 
            return i; 
    } 
 
    return -1; 
} 
