        printf("========================================\n"); 
 
        printf("1. Grammar 1\n"); 
        printf("2. Grammar 2\n"); 
        printf("3. Exit\n"); 
 
        printf("\nEnter your choice: "); 
        scanf("%d", &choice); 
 
        switch(choice) 
        { 
            case 1: 
 
                firstFollowG1(); 
 
                printTableG1(); 
 
                printf("\nEnter expression: "); 
                scanf("%s", input); 
                convertG1(input, converted); 
 
                printf("\nConverted input: %s\n", converted); 
 
