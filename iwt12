<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JavaScript Math & Error Examples</title>
</head>
<body>
    <h1>JavaScript Math & Error Examples</h1>
    <div class="instructions">
        <p><strong>Note:</strong> The JavaScript code is executing in the background. Please open your browser's <strong>Developer Console</strong> (F12 -> Console) to see the results of these examples.</p>
    </div>

    <script>
        console.log("--- Math Properties ---");
        console.log("Math.E (Euler's No.):", Math.E);
        console.log("Math.PI:", Math.PI);
        console.log("Math.SQRT2 (Square root of 2):", Math.SQRT2);
        console.log("Math.SQRT1_2 (Square root of 1/2):", Math.SQRT1_2);
        console.log("Math.LN2 (Natural logarithm of 2):", Math.LN2);
        console.log("Math.LN10 (Natural logarithm of 10):", Math.LN10);
        console.log("Math.LOG2E (Base 2 of logarithm E):", Math.LOG2E);
        console.log("Math.LOG10E (Base 10 of logarithm E):", Math.LOG10E);

        console.log("\n--- Math Methods (Number to Integer) ---");
        let num1 = 4.6;
        console.log("Math.round(4.6) - nearest integer:", Math.round(num1));
        console.log("Math.ceil(4.6) - rounded up:", Math.ceil(num1));
        console.log("Math.floor(4.6) - rounded down:", Math.floor(num1));
        console.log("Math.trunc(4.6) - integer part only:", Math.trunc(num1));

        console.log("\n--- Math Methods (Sign, Pow, Sqrt, Abs) ---");
        console.log("Math.sign(4) - positive returns:", Math.sign(4));
        console.log("Math.sign(-4) - negative returns:", Math.sign(-4));
        console.log("Math.sign(0) - zero returns:", Math.sign(0));
        console.log("Math.pow(3, 2) - 3 to the power of 2:", Math.pow(3, 2));
        console.log("Math.sqrt(16) - square root:", Math.sqrt(16));
        console.log("Math.abs(-5) - absolute value:", Math.abs(-5));

        console.log("\n--- Math Methods (Trig, Min/Max, Random, Log) ---");
        console.log("Math.sin(Math.PI / 2):", Math.sin(Math.PI / 2));
        console.log("Math.cos(Math.PI):", Math.cos(Math.PI));
        
        console.log("Math.min(10, 5, 20):", Math.min(10, 5, 20));
        console.log("Math.max(10, 5, 20):", Math.max(10, 5, 20));
        console.log("Math.random() - between 0 & 1:", Math.random());
        console.log("Math.log(10):", Math.log(10));
        console.log("Math.log2(8):", Math.log2(8));

        console.log("\n--- Number toPrecision() ---");
        let precisionNum = 5.123456;
        console.log("Original number:", precisionNum);
        console.log("num.toPrecision(3):", precisionNum.toPrecision(3)); 
        console.log("num.toPrecision(2):", precisionNum.toPrecision(2)); 

        console.log("\n--- Errors: Try & Catch Block ---");
        try {
            console.log("Trying to execute a non-existent function...");
            thisFunctionDoesNotExist(); 
        } catch (err) {
            console.log("Error Caught! The error was:", err.message); 
        }

        console.log("\n--- Specific Error Types ---");
        
        try {
            console.log("Attempting to decode an invalid URI...");
            decodeURI("% % %");
        } catch (err) {
            console.log("URIError caught:", err.name, "->", err.message);
        }

        try {
            console.log("Attempting to parse invalid syntax...");
            eval('let fname = "John);');
        } catch (err) {
            console.log("SyntaxError caught:", err.name, "->", err.message);
        }
        
    </script>
</body>
</html>
