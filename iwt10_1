let num = Number(prompt("Enter a number:"));

let original = num;
let sum = 0;
let digits = num.toString().length;

while (num > 0) {
    let digit = num % 10;
    sum += digit ** digits;
    num = Math.floor(num / 10);
}

if (sum === original) {
    console.log(original + " is an Armstrong number");
} else {
    console.log(original + " is not an Armstrong number");
}